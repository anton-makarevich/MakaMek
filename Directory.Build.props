<?xml version="1.0" encoding="utf-8"?>
<Project>
    <PropertyGroup>
        <VersionPrefix>0.66.17</VersionPrefix>
        <!-- Single source of truth for the Avalonia version (platform packages, Skia, themes, Browser head, headless tests). -->
        <AvaloniaVersion>12.1.6</AvaloniaVersion>
        <!-- Single source of truth for the Avalonia Developer Tools version (global 'avdt' tool and the Debug-only AvaloniaUI.DiagnosticsSupport package). Keep both in sync with the installed tool. -->
        <AvaloniaDevToolsVersion>2.2.3</AvaloniaDevToolsVersion>
        <!-- Deterministic analyzer gate (see issue #1708). Enabled only for the reusable
             libraries; tests, Avalonia, tools, source generators and infra are excluded. -->
        <SonarAnalyzerVersion>10.36.0.15337</SonarAnalyzerVersion>
        <EnableDeterministicAnalyzers Condition="'$(EnableDeterministicAnalyzers)' == ''">false</EnableDeterministicAnalyzers>
        <EnableDeterministicAnalyzers Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectDirectory)', '[/\\]src[/\\]MakaMek\.(Core|Presentation|Map|Services|Assets|Localization|Bots)([/\\]|$)'))">true</EnableDeterministicAnalyzers>

        <!-- Set the SDK-known properties unconditionally: some IDE project-file schemas
             reject a Condition attribute on them. -->
        <DeterministicAnalysisMode Condition="'$(EnableDeterministicAnalyzers)' == 'true'">Recommended</DeterministicAnalysisMode>
        <DeterministicEnforceCodeStyleInBuild Condition="'$(EnableDeterministicAnalyzers)' == 'true'">true</DeterministicEnforceCodeStyleInBuild>
        <DeterministicEnableNETAnalyzers>true</DeterministicEnableNETAnalyzers>
        <DeterministicEnableNETAnalyzers Condition="'$(EnableDeterministicAnalyzers)' != 'true'">false</DeterministicEnableNETAnalyzers>

        <AnalysisMode>$(DeterministicAnalysisMode)</AnalysisMode>
        <EnforceCodeStyleInBuild>$(DeterministicEnforceCodeStyleInBuild)</EnforceCodeStyleInBuild>
        <EnableNETAnalyzers>$(DeterministicEnableNETAnalyzers)</EnableNETAnalyzers>
        <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
        <Authors>Anton Makarevich</Authors>
        <Company>Anton Makarevich</Company>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- Code-metrics thresholds (CA1502/CA1506) validated by CA1509. -->
    <ItemGroup Condition="'$(EnableDeterministicAnalyzers)' == 'true'">
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
    </ItemGroup>

    <!-- Analyzer-only, applies to the reusable libraries; rule severities live in .editorconfig. -->
    <ItemGroup Condition="'$(EnableDeterministicAnalyzers)' == 'true'">
        <PackageReference Include="SonarAnalyzer.CSharp" Version="$(SonarAnalyzerVersion)" PrivateAssets="all"
                          IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

    <!-- Invoked from `mise run install-devtools`; update||install keeps a missing/fresh global tool working. -->
    <Target Name="InstallAvaloniaDevTools">
        <Exec Command="dotnet tool update --global AvaloniaUI.DeveloperTools --version $(AvaloniaDevToolsVersion) --allow-downgrade || dotnet tool install --global AvaloniaUI.DeveloperTools --version $(AvaloniaDevToolsVersion)" />
    </Target>
</Project>

