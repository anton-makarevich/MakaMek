<Project>

    <!--
      Generates BucketDefaults.g.cs with the build-time-embedded data bucket base URL.
      The value arrives as a global MSBuild property (-p:DataBucketBaseUrl),
      typically passed by CI workflows. When unset (local development), the constant
      is emitted as null and BucketDefaults falls back to the public bucket URL.
    -->
    <Target Name="GenerateBucketDefaults" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <BucketDefaultsFile>$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'generated', 'BucketDefaults.g.cs'))</BucketDefaultsFile>
            <_DataBucketBaseUrlLiteral Condition="'$(DataBucketBaseUrl)' == ''">null</_DataBucketBaseUrlLiteral>
            <_DataBucketBaseUrlLiteral Condition="'$(DataBucketBaseUrl)' != ''">"$(DataBucketBaseUrl)"</_DataBucketBaseUrlLiteral>
        </PropertyGroup>

        <ItemGroup>
            <_BucketDefaultsLine Include="// &lt;auto-generated&gt; Generated by GenerateBucketDefaults target - do not edit." />
            <_BucketDefaultsLine Include="// &lt;/auto-generated&gt;" />
            <_BucketDefaultsLine Include=" " />
            <_BucketDefaultsLine Include="namespace Sanet.MakaMek.Assets.Configuration%3B" />
            <_BucketDefaultsLine Include=" " />
            <_BucketDefaultsLine Include="public static partial class BucketDefaults" />
            <_BucketDefaultsLine Include="{" />
            <_BucketDefaultsLine Include="    internal const string%3F BuildTimeBaseUrl = $(_DataBucketBaseUrlLiteral)%3B" />
            <_BucketDefaultsLine Include="}" />
        </ItemGroup>

        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(BucketDefaultsFile)'))" />
        <WriteLinesToFile File="$(BucketDefaultsFile)"
                          Lines="@(_BucketDefaultsLine)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <Compile Include="$(BucketDefaultsFile)" Link="Configuration\BucketDefaults.g.cs" />
            <FileWrites Include="$(BucketDefaultsFile)" />
        </ItemGroup>
    </Target>

</Project>
