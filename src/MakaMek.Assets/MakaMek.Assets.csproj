<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Sanet.MakaMek.Assets</AssemblyName>
        <RootNamespace>Sanet.MakaMek.Assets</RootNamespace>
        <Description>An Attempt of Classic BattleTech game implementation. Asset Management</Description>
    </PropertyGroup>
    
    <ItemGroup>
        <InternalsVisibleTo Include="Sanet.MakaMek.Assets.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="" />
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
      <PackageReference Update="SonarAnalyzer.CSharp" Version="10.37.0.15768" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\MakaMek.Core\MakaMek.Core.csproj" />
      <ProjectReference Include="..\MakaMek.Map\MakaMek.Map.csproj" />
      <ProjectReference Include="..\MakaMek.Services\MakaMek.Services.csproj" />
    </ItemGroup>

    <Import Project="BucketDefaults.targets" />

    <!-- Debug target to print properties -->
    <Target Name="PrintProperties" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
        <Message Importance="high" Text="Project: $(MSBuildProjectName)" />
        <Message Importance="high" Text="Version: $(Version)" />
        <Message Importance="high" Text="Authors: $(Authors)" />
        <Message Importance="high" Text="Company: $(Company)" />
    </Target>
</Project>
