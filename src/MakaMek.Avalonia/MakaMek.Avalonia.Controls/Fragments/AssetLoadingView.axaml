<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Sanet.MakaMek.Presentation.ViewModels;assembly=Sanet.MakaMek.Presentation"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="80"
             x:Class="Sanet.MakaMek.Avalonia.Controls.Fragments.AssetLoadingView"
             x:DataType="viewModels:AssetLoadingViewModel">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="20">
        <ProgressBar Value="{Binding LoadingProgress}"
                     Minimum="0"
                     Maximum="1"
                     Width="300"
                     Height="6"/>
        <TextBlock Text="{Binding LoadingText}"
                   Classes="body"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
