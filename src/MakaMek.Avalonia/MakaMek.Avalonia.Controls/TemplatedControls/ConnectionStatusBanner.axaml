<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Sanet.MakaMek.Avalonia.Controls.TemplatedControls">

    <Style Selector="controls|ConnectionStatusBanner">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Classes="connectionBanner"
                        Background="{TemplateBinding ConnectionStatus, Converter={StaticResource ConnectionStatusBackgroundConverter}}">
                    <TextBlock Text="{TemplateBinding ConnectionStatus, Converter={StaticResource ConnectionStatusTextConverter}}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
