<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:templatedControls="using:Sanet.MakaMek.Avalonia.Controls.TemplatedControls"
             xmlns:wrappers="using:Sanet.MakaMek.Presentation.ViewModels.Wrappers"
             xmlns:viewModels1="using:Sanet.MakaMek.Presentation.ViewModels"
             xmlns:extensions="using:Sanet.MakaMek.Avalonia.Controls.Extensions"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="Sanet.MakaMek.Avalonia.Controls.PhysicalAttackDeclarationPanel"
             x:DataType="viewModels1:BattleMapViewModel"
             x:CompileBindings="True">

    <templatedControls:GamePanel
        IsVisible="{Binding IsPhysicalAttackDeclarationVisible}"
        Title="{extensions:Localize 'PhysicalAttackDeclaration_Title'}"
        CloseCommand="{Binding ClosePhysicalAttackDeclarationCommand}"
        HorizontalAlignment="Right"
        VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*"
              ColumnDefinitions="*"
              Width="300">
            <StackPanel
                Grid.Row="0"
                Margin="10,10,10,0"
                Orientation="Horizontal"
                Spacing="5">
                <TextBlock
                    FontFamily="{StaticResource AwesomeFontSolid}"
                    Text="&#xf05b;"/>
                <TextBlock Text="{Binding PhysicalAttackTarget.Name}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <ItemsControl
                    Margin="{StaticResource PageMargin}"
                    ItemsSource="{Binding PhysicalAttackOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="wrappers:PhysicalAttackOptionViewModel">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  Margin="0,6">
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding AttackTypeName}"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"/>

                                <Button Classes="cardAction"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"
                                        IsVisible="{Binding AttackPossibilityDescription, Converter={StaticResource StringNotEmptyToBoolConverter}}">
                                    <Button.Content>
                                        <TextBlock FontFamily="{StaticResource AwesomeFontSolid}" Text="&#xF05A;"/>
                                    </Button.Content>
                                    <Button.Flyout>
                                        <Flyout Placement="TopEdgeAlignedRight">
                                            <TextBlock Text="{Binding AttackPossibilityDescription}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="300"/>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,2,0,0">
                                    <TextBlock
                                        Classes="probabilityText"
                                        Text="{Binding TargetNumberText}"
                                        IsVisible="{Binding IsEnabled}"/>
                                    <TextBlock
                                        Classes="probabilityText"
                                        Text="{Binding HitProbabilityText}"
                                        Foreground="{Binding HitProbability, Converter={StaticResource HitProbabilityColorConverter}}"/>
                                </StackPanel>

                                <ItemsControl
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    ItemsSource="{Binding LimbOptions}"
                                    IsVisible="{Binding HasLimbOptions}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="wrappers:PhysicalAttackLimbOptionViewModel">
                                            <CheckBox
                                                Classes="limbOption"
                                                Content="{Binding Label}"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                IsEnabled="{Binding IsEnabled}"
                                                Margin="0,0,10,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </templatedControls:GamePanel>
</UserControl>
