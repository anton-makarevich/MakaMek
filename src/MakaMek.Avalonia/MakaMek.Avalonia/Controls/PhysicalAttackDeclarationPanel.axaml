<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:templatedControls="using:Sanet.MakaMek.Avalonia.Controls.TemplatedControls"
             xmlns:wrappers="using:Sanet.MakaMek.Presentation.ViewModels.Wrappers"
             xmlns:viewModels1="using:Sanet.MakaMek.Presentation.ViewModels"
             xmlns:extensions="using:Sanet.MakaMek.Avalonia.Controls.Extensions"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="Sanet.MakaMek.Avalonia.Controls.PhysicalAttackDeclarationPanel"
             x:DataType="viewModels1:BattleMapViewModel"
             x:CompileBindings="True">

    <templatedControls:GamePanel
        IsVisible="{Binding IsPhysicalAttackDeclarationVisible}"
        Title="{extensions:Localize 'PhysicalAttackDeclaration_Title'}"
        CloseCommand="{Binding ClosePhysicalAttackDeclarationCommand}"
        HorizontalAlignment="Right"
        VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*"
              ColumnDefinitions="Auto,*"
              Width="300">
            <TextBlock
                Margin="10,0,0,0"
                Grid.Column="0"
                Grid.Row="0"
                FontFamily="{StaticResource AwesomeFontSolid}" Text="&#xe19b;"/>
            <TextBlock
                Margin="10,0,0,0"
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding Attacker.Name}"/>

            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="10,10,0,0"
                Orientation="Horizontal"
                Spacing="5">
                <TextBlock
                    FontFamily="{StaticResource AwesomeFontSolid}"
                    Text="&#xf05b;"/>
                <TextBlock Text="{Binding PhysicalAttackTarget.Name}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                <ItemsControl
                    Margin="{StaticResource PageMargin}"
                    ItemsSource="{Binding PhysicalAttackOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="wrappers:PhysicalAttackOptionViewModel">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  RowDefinitions="Auto,Auto"
                                  Margin="0,6">
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding AttackTypeName}"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"/>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding HasDamage}">
                                        <TextBlock
                                            FontFamily="{StaticResource AwesomeFontSolid}"
                                            Text="&#x26a1;"/>
                                        <TextBlock Text="{Binding DamageText}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Classes="probabilityText"
                                    VerticalAlignment="Center"
                                    Margin="5,0"
                                    Text="{Binding HitProbabilityText}"
                                    Foreground="{Binding HitProbability, Converter={StaticResource HitProbabilityColorConverter}}"/>

                                <Button Classes="cardAction"
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"
                                        IsVisible="{Binding AttackPossibilityDescription, Converter={StaticResource StringNotEmptyToBoolConverter}}">
                                    <Button.Content>
                                        <TextBlock FontFamily="{StaticResource AwesomeFontSolid}" Text="&#xF05A;"/>
                                    </Button.Content>
                                    <Button.Flyout>
                                        <Flyout Placement="TopEdgeAlignedRight">
                                            <TextBlock Text="{Binding AttackPossibilityDescription}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="300"/>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <ItemsControl
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    ItemsSource="{Binding LimbOptions}"
                                    IsVisible="{Binding HasLimbOptions}"
                                    Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="wrappers:PhysicalAttackLimbOptionViewModel">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                Margin="0,0,10,0">
                                                <CheckBox
                                                    Classes="limbOption"
                                                    Content="{Binding Label}"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    IsEnabled="{Binding IsEnabled}"/>
                                                <Button Classes="cardAction"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding HasRestrictionReason}"
                                                        ToolTip.Tip="{Binding RestrictionReason}">
                                                    <Button.Content>
                                                        <TextBlock FontFamily="{StaticResource AwesomeFontSolid}" Text="&#xF05A;"/>
                                                    </Button.Content>
                                                    <Button.Flyout>
                                                        <Flyout Placement="TopEdgeAlignedRight">
                                                            <TextBlock Text="{Binding RestrictionReason}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="300"/>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </templatedControls:GamePanel>
</UserControl>
