<Project>

    <!--
      Generates DemoHubDefaults.g.cs with build-time-embedded Demo hub values.
      Values arrive as global MSBuild properties (-p:DemoHubBaseUrl / -p:DemoHubApiKey),
      typically passed by CI workflows. When unset (local development), the constants
      are emitted as null and DemoHubDefaults falls back to its local defaults.
    -->
    <Target Name="GenerateDemoHubDefaults" BeforeTargets="CoreCompile">
        <PropertyGroup>
            <DemoHubDefaultsFile>$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'generated', 'DemoHubDefaults.g.cs'))</DemoHubDefaultsFile>
            <_DemoHubBaseUrlLiteral Condition="'$(DemoHubBaseUrl)' == ''">null</_DemoHubBaseUrlLiteral>
            <_DemoHubBaseUrlLiteral Condition="'$(DemoHubBaseUrl)' != ''">"$(DemoHubBaseUrl)"</_DemoHubBaseUrlLiteral>
            <_DemoHubApiKeyLiteral Condition="'$(DemoHubApiKey)' == ''">null</_DemoHubApiKeyLiteral>
            <_DemoHubApiKeyLiteral Condition="'$(DemoHubApiKey)' != ''">"$(DemoHubApiKey)"</_DemoHubApiKeyLiteral>
        </PropertyGroup>

        <ItemGroup>
            <_DemoHubDefaultsLine Include="// &lt;auto-generated&gt; Generated by GenerateDemoHubDefaults target - do not edit." />
            <_DemoHubDefaultsLine Include="// &lt;/auto-generated&gt;" />
            <_DemoHubDefaultsLine Include=" " />
            <_DemoHubDefaultsLine Include="namespace Sanet.MakaMek.Avalonia.DI%3B" />
            <_DemoHubDefaultsLine Include=" " />
            <_DemoHubDefaultsLine Include="public static partial class DemoHubDefaults" />
            <_DemoHubDefaultsLine Include="{" />
            <_DemoHubDefaultsLine Include="    internal const string%3F BuildTimeBaseUrl = $(_DemoHubBaseUrlLiteral)%3B" />
            <_DemoHubDefaultsLine Include=" " />
            <_DemoHubDefaultsLine Include="    internal const string%3F BuildTimeApiKey = $(_DemoHubApiKeyLiteral)%3B" />
            <_DemoHubDefaultsLine Include="}" />
        </ItemGroup>

        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(DemoHubDefaultsFile)'))" />
        <WriteLinesToFile File="$(DemoHubDefaultsFile)"
                          Lines="@(_DemoHubDefaultsLine)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <Compile Include="$(DemoHubDefaultsFile)" Link="DI\DemoHubDefaults.g.cs" />
            <FileWrites Include="$(DemoHubDefaultsFile)" />
        </ItemGroup>
    </Target>

</Project>


