<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Sanet.MakaMek.Avalonia.Controls"
             xmlns:mapControls="using:Sanet.MakaMek.Avalonia.Controls"
             xmlns:templatedControls="using:Sanet.MakaMek.Avalonia.Controls.TemplatedControls"
             xmlns:behaviors="using:Sanet.MakaMek.Avalonia.Behaviors"
             xmlns:viewModels1="using:Sanet.MakaMek.Presentation.ViewModels"
             xmlns:uiStates="using:Sanet.MakaMek.Presentation.UiStates"
             xmlns:units="using:Sanet.MakaMek.Core.Models.Units"
             xmlns:extensions="using:Sanet.MakaMek.Avalonia.Controls.Extensions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Sanet.MakaMek.Avalonia.Views.BattleMapView"
             x:CompileBindings="True"
             x:DataType="viewModels1:BattleMapViewModel">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid Container.Name="battleMap"
          Container.Sizing="Width">
        <Grid.Styles>
            <Style Selector="Border.statusSection">
                <Setter Property="Padding" Value="10,5"/>
            </Style>
            <ContainerQuery Name="battleMap" Query="max-width:700">
                <Style Selector="Border.statusSection">
                    <Setter Property="Padding" Value="6,3"/>
                </Style>
                <Style Selector="TextBlock.turnInfo">
                    <Setter Property="FontSize" Value="11"/>
                </Style>
                <Style Selector="TextBlock.turnInfoLabel">
                    <Setter Property="FontSize" Value="9"/>
                </Style>
            </ContainerQuery>
        </Grid.Styles>
        <mapControls:HexMap x:Name="MapCanvas"
                            Background="Transparent"
                            BoundaryOutlines="{Binding HighlightBoundaryOutlines}"
                            HexConfiguration="{Binding HexConfiguration}">
            <controls:DirectionSelector
                x:Name="DirectionSelector"
                IsVisible="{Binding IsDirectionSelectorVisible}"
                EnabledDirections="{Binding AvailableDirections}"
                Position="{Binding DirectionSelectorPosition}"
                DirectionSelectedCommand="{Binding DirectionSelectedCommand}"
                ActiveTint="{Binding ActivePlayerTint}"/>
            <controls:SurfaceSelector
                x:Name="SurfaceSelector"
                IsVisible="{Binding IsSurfaceSelectorVisible}"
                Options="{Binding SurfaceSelector.Options}"
                Position="{Binding SurfaceSelectorPosition}"
                SurfaceSelectedCommand="{Binding SurfaceSelectedCommand}"/>
        </mapControls:HexMap>
        
        <Grid x:Name="TurnStatus"
            RowDefinitions="50,Auto"
            VerticalAlignment="Top"
            Background="{StaticResource OverlayTransparentBrush}"
            Classes="statusPanel"
            ColumnDefinitions="Auto,*">
            <templatedControls:ActionButton
                Margin="5"
                Command="{Binding LeaveGameCommand}"
                IconData="{StaticResource CloseIcon}"
                />
            <Grid Grid.Column="1"
                  Grid.Row="0"
                  x:Name="TurnInfoPanel"
                  Background="{Binding ActivePlayerTint, Converter={StaticResource HexColorToBrushConverter}}"
                  ColumnDefinitions="*,*,*">
                <!-- Turn Info Section -->
                <Border Grid.Column="0" 
                    Classes="statusSection">
                    <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="{extensions:Localize 'BattleMap_Turn'}"
                                     Classes="turnInfoLabel"
                                     HorizontalAlignment="Center"
                                     Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"/>
                            <TextBlock Text="{Binding Turn}"
                                     Classes="turnInfo"
                                     FontWeight="Bold" 
                                     HorizontalAlignment="Center"
                                     Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="{extensions:Localize 'BattleMap_Phase'}"
                                     Classes="turnInfoLabel"
                                     HorizontalAlignment="Center"
                                     Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"/>
                            <TextBlock Text="{Binding TurnPhaseName}"
                                     Classes="turnInfo"
                                     FontWeight="Bold" 
                                     TextWrapping="Wrap"
                                     TextAlignment="Center"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Active Player Section -->
                <Border Grid.Column="1" 
                        Classes="statusSection"
                        Margin="1,0,1,0">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="{extensions:Localize 'BattleMap_ActivePlayer'}"
                                 Classes="turnInfoLabel"
                                 HorizontalAlignment="Center"
                                 Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"/>
                        <TextBlock Text="{Binding ActivePlayerName}"
                                 Classes="turnInfo"
                                 FontWeight="Bold" 
                                 HorizontalAlignment="Center"
                                 Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"/>
                    </StackPanel>
                </Border>
                
                <!-- Player Action Section -->
                <Border Grid.Column="2" 
                        Classes="statusSection"
                        IsVisible="{Binding IsTurnActionPanelVisible}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TurnActionStatusLabel}"
                                 Classes="turnInfo"
                                 TextWrapping="Wrap"
                                 FontWeight="Bold"
                                 Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"
                                 VerticalAlignment="Center"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveUnitLabel}"
                                   Classes="turnInfoLabel"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"/>
                        <TextBlock Text="{Binding TurnGuidanceLabel}"
                                   Classes="turnInfoLabel"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Surfaces the rejection and timeout feedback from the client game. -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    IsVisible="{Binding IsCommandFeedbackVisible}"
                    Background="{StaticResource ErrorBrush}"
                    Padding="10,4">
                <TextBlock Text="{Binding CommandFeedbackLabel}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextLightBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Border>

        </Grid>

        <templatedControls:ConnectionStatusBanner
                IsVisible="{Binding IsConnectionBannerVisible}"
                ConnectionStatus="{Binding ConnectionStatus.OnlineConnectionStatus}"
                VerticalAlignment="Top"
                Margin="60,56,60,0"/>

        <templatedControls:TurnNotificationBanner
                Notifications="{Binding TurnNotifications}"
                ShownCommand="{Binding TurnNotificationShownCommand}"
                VerticalAlignment="Top"
                Margin="60,92,60,0"/>

        <Grid x:Name="MechList"
              Background="{StaticResource SecondaryBrush}"
              IsVisible="{Binding AreUnitsToDeployVisible}"
              RowDefinitions="Auto,*"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Classes="card">
            <Label Content="{extensions:Localize 'BattleMap_SelectUnitToDeploy'}" Foreground="{StaticResource HighlightLightBrush}"/>
            <ListBox Grid.Row="1"
                Classes="gameList"
                ItemsSource="{Binding UnitsToDeploy}"
                SelectedItem="{Binding SelectedUnit}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock 
                            Text="{Binding Name}"
                            Classes="body"
                            Foreground="{StaticResource TextLightBrush}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        
        <controls:WeaponSelectionPanel
            x:Name="WeaponSelectionPanel"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"/>

        <!-- Body Part Selector for Aimed Shots -->
        <templatedControls:GamePanel
            IsVisible="{Binding IsUnitPartSelectorVisible}"
            Title="{extensions:Localize 'BattleMap_SelectTargetLocation'}"
            CloseCommand="{Binding HideBodyPartSelectorCommand}"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <controls:UnitPartSelector DataContext="{Binding UnitPartSelector}" />
        </templatedControls:GamePanel>
        
        <StackPanel x:Name="MapControlsDrawer"
                    HorizontalAlignment="{Binding AreActionsMenuOffMap, Converter={StaticResource CompactPanelLayoutConverter}, ConverterParameter=controlsHorizontal}"
                    VerticalAlignment="{Binding AreActionsMenuOffMap, Converter={StaticResource CompactPanelLayoutConverter}, ConverterParameter=controlsVertical}"
                    Margin="{Binding AreActionsMenuOffMap, Converter={StaticResource CompactPanelLayoutConverter}, ConverterParameter=controlsMargin}"
                    Spacing="10"
                    IsVisible="{Binding IsMapControlsDrawerOpen}">
            <!-- Children stretch to the panel's widest item and would otherwise draw their 40pt
                 circle against the left edge of that box, leaving the column out of line with the
                 toggle that opens it. -->
            <StackPanel.Styles>
                <Style Selector="templatedControls|ActionButton">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
                <Style Selector="Button.actionButtonText">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
            </StackPanel.Styles>

            <!-- Advances to the next living, non-shutdown squad member and centers the map. -->
            <Button Classes="actionButtonText"
                    IsVisible="{Binding IsNextAvailableUnitVisible}"
                    Command="{Binding NextAvailableUnitCommand}"
                    ToolTip.Tip="{extensions:Localize 'BattleMap_NextUnit'}"
                    Background="{Binding ActivePlayerTint, Converter={StaticResource HexColorToBrushConverter}}"
                    Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"
                    Content="{extensions:Localize 'BattleMap_NextUnit'}"/>

            <!-- Center Map Button -->
            <templatedControls:ActionButton
                Command="{Binding CenterMapCommand}"
                ToolTip.Tip="{extensions:Localize 'BattleMap_ResetMap'}"
                IconData="{StaticResource CenterMapIcon}"/>

            <templatedControls:ActionButton
                Command="{Binding ZoomInCommand}"
                AutomationProperties.Name="{extensions:Localize 'BattleMap_ZoomIn'}"
                ToolTip.Tip="{extensions:Localize 'BattleMap_ZoomIn'}"
                IconData="{StaticResource ZoomInIcon}"/>
            <templatedControls:ActionButton
                Command="{Binding ZoomOutCommand}"
                AutomationProperties.Name="{extensions:Localize 'BattleMap_ZoomOut'}"
                ToolTip.Tip="{extensions:Localize 'BattleMap_ZoomOut'}"
                IconData="{StaticResource ZoomOutIcon}"/>
            <templatedControls:ActionButton
                Command="{Binding FitMapCommand}"
                AutomationProperties.Name="{extensions:Localize 'BattleMap_FitMap'}"
                ToolTip.Tip="{extensions:Localize 'BattleMap_FitMap'}"
                IconData="{StaticResource FitMapIcon}"/>

            <!-- Record Sheet Button -->
            <templatedControls:ActionButton
                IsVisible="{Binding IsRecordSheetButtonVisible}"
                Command="{Binding ToggleRecordSheet}"
                ToolTip.Tip="{extensions:Localize 'BattleMap_UnitInfo'}"
                IconData="{StaticResource RecordSheetIcon}"/>

            <!-- Command Log Button -->
            <templatedControls:ActionButton
                IsVisible="{Binding !IsCommandLogExpanded}"
                Command="{Binding ToggleCommandLog}"
                ToolTip.Tip="{extensions:Localize 'BattleMap_Commands'}"
                IconData="{StaticResource CommandLogIcon}"/>

            <!-- Map Settings Button -->
            <templatedControls:ActionButton
                IsVisible="{Binding !IsMapSettingsPanelVisible}"
                Command="{Binding ToggleMapSettings}"
                ToolTip.Tip="{extensions:Localize 'BattleMap_MapSettings'}"
                IconData="{StaticResource MapSettingsIcon}"/>

            <!-- Export PDF Button -->
            <Button Classes="actionButtonText"
                    IsVisible="{Binding CanExportPdf}"
                    Command="{Binding ExportMapToPdfCommand}"
                    ToolTip.Tip="{extensions:Localize 'BattleMap_ExportPdf'}"
                    Background="{Binding ActivePlayerTint, Converter={StaticResource HexColorToBrushConverter}}"
                    Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"
                    Content="{extensions:Localize 'BattleMap_ExportPdf'}"/>
        </StackPanel>

        <templatedControls:ActionButton
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,12,0"
            Command="{Binding ToggleMapControlsDrawer}"
            AutomationProperties.Name="{extensions:Localize 'BattleMap_MapControls'}"
            ToolTip.Tip="{extensions:Localize 'BattleMap_MapControls'}"
            IconData="{StaticResource MapSettingsIcon}"/>

        <!-- Persistent squad overview. The cards sit outside the drawer so round status stays
             visible while the map remains the primary workspace. -->
        <ScrollViewer HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"
                      Height="78"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Hidden"
                      IsVisible="{Binding IsSquadStatusBarVisible}">
            <ScrollViewer.Margin>
                <!-- Full width, inset only by whatever the drawer is actually taking. -->
                <MultiBinding Converter="{StaticResource SquadBarMarginConverter}">
                    <Binding Path="AreActionsMenuOffMap"/>
                    <Binding ElementName="MapControlsDrawer" Path="Bounds.Width"/>
                </MultiBinding>
            </ScrollViewer.Margin>
            <ItemsControl ItemsSource="{Binding LocalUnits}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="units:IUnit">
                        <controls:UnitStatusBarItem
                            InspectCommand="{Binding $parent[UserControl].((viewModels1:BattleMapViewModel)DataContext).InspectUnitCommand}"
                            FocusCommand="{Binding $parent[UserControl].((viewModels1:BattleMapViewModel)DataContext).FocusUnitCommand}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Spacing="4"
            Margin="{Binding AreActionsMenuOffMap, Converter={StaticResource CompactPanelLayoutConverter}, ConverterParameter=actionMargin}">
            
            <!-- Mobile Unit Action Buttons (fixed overlay, visible only on mobile) -->
            <ItemsControl x:Name="MobileActionButtonsPanel"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          IsVisible="{Binding AreActionsMenuOffMap}"
                          ItemsSource="{Binding AvailableActions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"
                                    Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="uiStates:StateAction">
                        <Button Classes="actionButtonText"
                                Command="{Binding OnExecute, Converter={StaticResource ActionToCommandConverter}}"
                                HorizontalAlignment="Center" 
                                IsVisible="{Binding IsVisible}"
                                Background="{Binding $parent[UserControl].((viewModels1:BattleMapViewModel)DataContext).ActivePlayerTint, Converter={StaticResource HexColorToBrushConverter}}"
                                Foreground="{Binding $parent[UserControl].((viewModels1:BattleMapViewModel)DataContext).ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"
                                Content="{Binding Label}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Player Action Button -->
            <Button Classes="actionButtonText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Command="{Binding HandlePlayerAction}"
                    IsVisible="{Binding IsPlayerActionButtonVisible}"
                    Background="{Binding ActivePlayerTint, Converter={StaticResource HexColorToBrushConverter}}"
                    Foreground="{Binding ActivePlayerTint, Converter={StaticResource ContrastingForegroundConverter}}"
                    Content="{Binding PlayerActionLabel}"/>
        </StackPanel>

        <!-- Record Sheet Panel -->
        <templatedControls:GamePanel
            x:Name="RecordSheetPanel"
            IsVisible="{Binding IsRecordSheetPanelVisible}"
            Title="{Binding InspectedUnit.Name}"
            CloseCommand="{Binding ToggleRecordSheet}"
            HorizontalAlignment="{Binding AreActionsMenuOffMap, Converter={StaticResource CompactPanelLayoutConverter}, ConverterParameter=horizontal}"
            VerticalAlignment="{Binding AreActionsMenuOffMap, Converter={StaticResource CompactPanelLayoutConverter}, ConverterParameter=vertical}"
            Margin="{Binding AreActionsMenuOffMap, Converter={StaticResource CompactPanelLayoutConverter}, ConverterParameter=margin}"
            MinHeight="0"
            MaxWidth="{Binding AreActionsMenuOffMap, Converter={StaticResource CompactPanelLayoutConverter}, ConverterParameter=maxWidth}"
            MaxHeight="{Binding AreActionsMenuOffMap, Converter={StaticResource CompactPanelLayoutConverter}, ConverterParameter=maxHeight}">
            <controls:UnitRecordSheet
                Unit="{Binding InspectedUnit}"
                HeatProjection="{Binding SelectedUnitHeatProjection}"
                FocusCommand="{Binding FocusUnitCommand}"
                PinCommand="{Binding ToggleRecordSheetPin}"
                IsPinned="{Binding IsRecordSheetPinned}"
                ShowHeatLevelPanel="True"
                ShowEventsTab="True" />
        </templatedControls:GamePanel>

        <!-- Command Log Panel -->
        <templatedControls:GamePanel
            IsVisible="{Binding IsCommandLogExpanded}"
            Title="{extensions:Localize 'BattleMap_CommandLog'}"
            CloseCommand="{Binding ToggleCommandLog}">
            <ListBox
                MaxHeight="360"
                behaviors:AutoScrollBehavior.EnableListBoxAutoScroll="True"
                ItemsSource="{Binding CommandLog}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="5"
                                   TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </templatedControls:GamePanel>

        <!-- Map Settings Panel -->
        <templatedControls:GamePanel
            IsVisible="{Binding IsMapSettingsPanelVisible}"
            Title="{extensions:Localize 'BattleMap_Settings'}"
            CloseCommand="{Binding ToggleMapSettings}">
            <StackPanel Margin="{StaticResource PageMargin}" Spacing="10">
                <CheckBox Content="{extensions:Localize 'BattleMap_ShowLabels'}"
                          IsChecked="{Binding HexConfiguration.ShowLabels}"
                          Foreground="{StaticResource TextBrush}"/>
                <CheckBox Content="{extensions:Localize 'BattleMap_ShowHexOutlines'}"
                          IsChecked="{Binding HexConfiguration.ShowOutline}"
                          Foreground="{StaticResource TextBrush}"/>
                <CheckBox Content="{extensions:Localize 'BattleMap_ShowHexHighlightText'}"
                          IsChecked="{Binding HexConfiguration.ShowHighlightLabels}"
                          Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </templatedControls:GamePanel>
    </Grid>
</UserControl>
