<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fragments="using:Sanet.MakaMek.Avalonia.Views.JoinGame.Fragments"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Sanet.MakaMek.Avalonia.Views.JoinGame.JoinGameViewNarrow"
             x:DataType="viewModels:JoinGameViewModel"
             xmlns:viewModels="using:Sanet.MakaMek.Presentation.ViewModels"
             xmlns:fragments2="using:Sanet.MakaMek.Avalonia.Views.StartNewGame.Fragments"
             xmlns:templatedControls="using:Sanet.MakaMek.Avalonia.Controls.TemplatedControls"
             xmlns:extensions="using:Sanet.MakaMek.Avalonia.Controls.Extensions">

  <Grid>
    <templatedControls:HexagonBackground/>
    <DockPanel Classes="pageContainer">
    <templatedControls:ToolBar
      Title="{extensions:Localize 'JoinGame_Title'}"
      TitleAlignment="Center"
      LeftCommand="{Binding BackCommand}"
      LeftIcon="{StaticResource BackArrowIcon}"
      DockPanel.Dock="Top"
      Margin="0,0,0,10"/>
    <ScrollViewer Classes="gameScrollViewer"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid RowDefinitions="Auto,Auto,Auto"
            Margin="{StaticResource PageMargin}"
            RowSpacing="15">
        <!-- Connect Fragment -->
       <Border Classes="card">
            <fragments:ConnectFragment DataContext="{Binding}"/>
          </Border>
        

        <!-- Players Fragment (Reused) -->
        <Border Grid.Row="1" Classes="card">
          <fragments2:PlayersFragment DataContext="{Binding}"/>
        </Border>

        <!-- Map Preview -->
        <Border Grid.Row="2" Classes="card" IsVisible="{Binding HasLobbyMapPreview}">
          <StackPanel Classes="formGroup">
            <TextBlock Text="{extensions:Localize 'Join_LobbyMapPreview'}" Classes="label"/>
            <Image Source="{Binding PreviewImage}" MaxWidth="400" MaxHeight="400"
                   Stretch="Uniform" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
  </Grid>
</UserControl>

