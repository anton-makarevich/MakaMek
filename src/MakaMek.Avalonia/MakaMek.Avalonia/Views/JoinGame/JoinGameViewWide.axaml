<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fragments="using:Sanet.MakaMek.Avalonia.Views.JoinGame.Fragments"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
             x:Class="Sanet.MakaMek.Avalonia.Views.JoinGame.JoinGameViewWide"
             x:DataType="viewModels:JoinGameViewModel"
             xmlns:viewModels="using:Sanet.MakaMek.Presentation.ViewModels"
             xmlns:fragments2="using:Sanet.MakaMek.Avalonia.Views.StartNewGame.Fragments"
             xmlns:templatedControls="using:Sanet.MakaMek.Avalonia.Controls.TemplatedControls"
             xmlns:extensions="using:Sanet.MakaMek.Avalonia.Controls.Extensions">

    <Grid>
        <templatedControls:HexagonBackground/>
        <Grid Margin="{StaticResource PageMargin}" 
              RowDefinitions="Auto,*">
            <templatedControls:ToolBar
                Title="{extensions:Localize 'JoinGame_Title'}"
            TitleAlignment="Center"
            LeftCommand="{Binding BackCommand}"
            LeftIcon="{StaticResource BackArrowIcon}"
            Margin="0,0,0,10"/>
            <Grid Grid.Row="1"
              Container.Name="joinGameContent"
              Container.Sizing="Width">
            <Grid.Styles>
                <Style Selector="UniformGrid#JoinGameAdaptiveGrid">
                    <Setter Property="Rows" Value="2"/>
                    <Setter Property="Columns" Value="0"/>
                </Style>
                <ContainerQuery Name="joinGameContent" Query="min-width:800">
                    <Style Selector="UniformGrid#JoinGameAdaptiveGrid">
                        <Setter Property="Rows" Value="0"/>
                        <Setter Property="Columns" Value="2"/>
                    </Style>
                </ContainerQuery>
            </Grid.Styles>
            <UniformGrid x:Name="JoinGameAdaptiveGrid">
                <!-- Left Column: Connect + Players -->
                <Grid RowDefinitions="Auto,*">
                    <!-- Connect Fragment -->
                    <Border Classes="card">
                        <fragments:ConnectFragment DataContext="{Binding}"/>
                    </Border>

                    <!-- Players Fragment (Reused) -->
                    <fragments2:PlayersFragment Grid.Row="1" DataContext="{Binding}"/>
                </Grid>

                <!-- Right Column: Map Preview -->
                <Border Classes="card" IsVisible="{Binding HasLobbyMapPreview}"
                        VerticalAlignment="Top">
                    <StackPanel Classes="formGroup">
                        <TextBlock Text="{extensions:Localize 'Join_LobbyMapPreview'}" Classes="label"/>
                        <Image Source="{Binding PreviewImage}" MaxWidth="400" MaxHeight="400"
                               Stretch="Uniform" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </Grid>
    </Grid>
</UserControl>

