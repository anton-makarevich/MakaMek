<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:templatedControls="clr-namespace:Sanet.MakaMek.Avalonia.Controls.TemplatedControls;assembly=Sanet.MakaMek.Avalonia.Controls"
             xmlns:viewModels="clr-namespace:Sanet.MakaMek.Presentation.ViewModels;assembly=Sanet.MakaMek.Presentation"
             xmlns:extensions="clr-namespace:Sanet.MakaMek.Avalonia.Controls.Extensions;assembly=Sanet.MakaMek.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="400"
             x:Class="Sanet.MakaMek.Avalonia.Views.Settings.AddProviderView"
             x:DataType="viewModels:AddProviderViewModel">

    <!-- Centered dialog panel -->
    <templatedControls:GamePanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        MinWidth="400"
        MaxWidth="600"
        Title="{extensions:Localize 'Settings_Data_Providers_AddDialogTitle'}"
        CloseCommand="{Binding CancelCommand}">
        <StackPanel Spacing="10" Padding="20">
            <StackPanel Classes="formGroup">
                <TextBlock Text="{extensions:Localize 'Settings_Data_Providers_Type'}"
                           Classes="label"/>
                <ComboBox ItemsSource="{Binding ProviderTypes}"
                          SelectedItem="{Binding SelectedProviderType, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>
            <StackPanel Classes="formGroup">
                <TextBlock Text="{extensions:Localize 'Settings_Data_Providers_AssetType'}"
                           Classes="label"/>
                <ComboBox ItemsSource="{Binding AssetTypes}"
                          SelectedItem="{Binding SelectedAssetType, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"/>
            </StackPanel>
            <StackPanel Classes="formGroup">
                <TextBlock Text="{extensions:Localize 'Settings_Data_Providers_UrlOrPath'}"
                           Classes="label"/>
                <TextBox Text="{Binding UrlOrPath, Mode=TwoWay}"/>
            </StackPanel>
            <TextBlock Text="{Binding ValidationMessage}"
                       IsVisible="{Binding HasValidationMessage}"
                       Classes="bodySmall"
                       TextWrapping="Wrap"
                       Foreground="Red"/>
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="{extensions:Localize 'Settings_Data_Providers_Add'}"
                        Command="{Binding ConfirmCommand}"
                        Classes="primary"/>
            </StackPanel>
        </StackPanel>
    </templatedControls:GamePanel>
</UserControl>
