<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Sanet.MakaMek.Presentation.ViewModels;assembly=Sanet.MakaMek.Presentation"
             xmlns:wrappers="clr-namespace:Sanet.MakaMek.Presentation.ViewModels.Wrappers;assembly=Sanet.MakaMek.Presentation"
             xmlns:extensions="clr-namespace:Sanet.MakaMek.Avalonia.Controls.Extensions;assembly=Sanet.MakaMek.Avalonia.Controls"
             xmlns:fragments="clr-namespace:Sanet.MakaMek.Avalonia.Controls.Fragments;assembly=Sanet.MakaMek.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Sanet.MakaMek.Avalonia.Views.Settings.Fragments.DataSectionFragment"
             x:DataType="viewModels:SettingsViewModel">
    <ScrollViewer Classes="gameScrollViewer"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="15">
            <TextBlock Text="{Binding CacheStatus}"
                       Classes="body"
                       FontWeight="SemiBold"/>
            <Button Content="{Binding ClearCacheButton}"
                    Command="{Binding ClearCacheCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Classes="primary"
                    HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding ClearCacheDescription}"
                       TextWrapping="Wrap"
                       Classes="body"
                       Foreground="Gray"/>

            <!-- Asset Providers -->
            <TextBlock Text="{Binding ProvidersSectionTitle}"
                       Classes="label"/>
            <ItemsControl ItemsSource="{Binding AssetProviders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="wrappers:AssetProviderEntryViewModel">
                        <Border Classes="gamePanel" Padding="10" CornerRadius="8">
                            <StackPanel Spacing="8">
                                <StackPanel Classes="horizontalSpaced">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding ProviderType}"
                                                   Classes="body"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AssetType}"
                                                   Classes="bodySmall"
                                                   Foreground="Gray"/>
                                        <TextBlock Text="{Binding UrlOrPath}"
                                                   Classes="bodySmall"
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding !IsEditing}"
                                                Classes="horizontalSpaced">
                                        <CheckBox IsChecked="{Binding IsActive, Mode=OneWay}"
                                                  Command="{Binding ToggleActiveCommand}"
                                                  IsEnabled="{Binding CanDeactivate}"
                                                  AutomationProperties.Name="{extensions:Localize 'Settings_Data_Providers_Activate'}"
                                                  ToolTip.Tip="{extensions:Localize 'Settings_Data_Providers_Activate'}"/>
                                        <Button Command="{Binding StartEditingCommand}"
                                                IsVisible="{Binding CanEdit}"
                                                AutomationProperties.Name="{extensions:Localize 'Settings_Data_Providers_Edit'}"
                                                ToolTip.Tip="{extensions:Localize 'Settings_Data_Providers_Edit'}"
                                                Classes="secondary inlineIcon">
                                            <TextBlock Text="&#xf304;"/>
                                        </Button>
                                        <Button Command="{Binding $parent[ItemsControl].((viewModels:SettingsViewModel)DataContext).RemoveAssetProviderCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding CanRemove}"
                                                AutomationProperties.Name="{extensions:Localize 'Settings_Data_Providers_Remove'}"
                                                ToolTip.Tip="{extensions:Localize 'Settings_Data_Providers_Remove'}"
                                                Classes="outline inlineIcon">
                                            <TextBlock Text="&#xf2ed;"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding IsEditing}" Spacing="8">
                                    <StackPanel Classes="formGroup">
                                        <TextBlock Text="{extensions:Localize 'Settings_Data_Providers_Type'}"
                                                   Classes="label"/>
                                        <ComboBox ItemsSource="{Binding $parent[ItemsControl].((viewModels:SettingsViewModel)DataContext).ProviderTypes}"
                                                  SelectedItem="{Binding EditableProviderType, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Classes="formGroup">
                                        <TextBlock Text="{extensions:Localize 'Settings_Data_Providers_AssetType'}"
                                                   Classes="label"/>
                                        <ComboBox ItemsSource="{Binding $parent[ItemsControl].((viewModels:SettingsViewModel)DataContext).AssetTypes}"
                                                  SelectedItem="{Binding EditableAssetType, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Classes="formGroup">
                                        <TextBlock Text="{extensions:Localize 'Settings_Data_Providers_UrlOrPath'}"
                                                   Classes="label"/>
                                        <TextBox Text="{Binding EditableUrlOrPath, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Classes="horizontalSpaced" HorizontalAlignment="Right">
                                        <Button Content="{extensions:Localize 'Settings_Data_Providers_Save'}"
                                                Command="{Binding SaveCommand}"
                                                Classes="primary"/>
                                        <Button Content="{extensions:Localize 'Settings_Data_Providers_Cancel'}"
                                                Command="{Binding CancelCommand}"
                                                Classes="secondary"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add Provider -->
            <TextBlock Text="{Binding AddProviderLabel}"
                       Classes="label"/>
            <Border Classes="gamePanel" Padding="10" CornerRadius="8">
                <StackPanel Spacing="8">
                    <StackPanel Classes="horizontalSpaced">
                        <StackPanel Classes="formGroup">
                            <TextBlock Text="{extensions:Localize 'Settings_Data_Providers_Type'}"
                                       Classes="label"/>
                            <ComboBox ItemsSource="{Binding ProviderTypes}"
                                      SelectedItem="{Binding SelectedAddProviderType, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Classes="formGroup">
                            <TextBlock Text="{extensions:Localize 'Settings_Data_Providers_AssetType'}"
                                       Classes="label"/>
                            <ComboBox ItemsSource="{Binding AssetTypes}"
                                      SelectedItem="{Binding SelectedAddAssetType, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Classes="formGroup">
                        <TextBlock Text="{extensions:Localize 'Settings_Data_Providers_UrlOrPath'}"
                                   Classes="label"/>
                        <TextBox Text="{Binding AddProviderUrlOrPath, Mode=TwoWay}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AddProviderValidationMessage}"
                               Classes="bodySmall"
                               Foreground="Red"/>
                    <Button Content="{Binding AddProviderLabel}"
                            Command="{Binding AddProviderCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            Classes="primary"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Reload -->
            <Button Content="{Binding ReloadProvidersLabel}"
                    Command="{Binding ReloadProvidersCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Classes="primary"
                    HorizontalAlignment="Left"/>
            <fragments:AssetLoadingView DataContext="{Binding AssetLoading}"
                                        IsVisible="{Binding IsLoading}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
