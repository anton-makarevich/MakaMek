<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Sanet.MakaMek.Presentation.ViewModels;assembly=Sanet.MakaMek.Presentation"
             xmlns:templatedControls="clr-namespace:Sanet.MakaMek.Avalonia.Controls.TemplatedControls;assembly=Sanet.MakaMek.Avalonia.Controls"
             xmlns:extensions="clr-namespace:Sanet.MakaMek.Avalonia.Controls.Extensions;assembly=Sanet.MakaMek.Avalonia.Controls"
             xmlns:fragments="clr-namespace:Sanet.MakaMek.Avalonia.Views.Settings.Fragments"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="viewModels:SettingsViewModel"
             x:Class="Sanet.MakaMek.Avalonia.Views.Settings.SettingsView">

    <Grid>
        <templatedControls:HexagonBackground/>
        <Grid Margin="10" RowDefinitions="Auto,*">
            <!-- Toolbar with Back Button -->
            <templatedControls:ToolBar
                Title="{extensions:Localize 'SettingsView_Title'}"
            TitleAlignment="Center"
            LeftCommand="{Binding BackCommand}"
            LeftIcon="{StaticResource BackArrowIcon}"/>

        <!-- Tabbed Content -->
        <TabControl Grid.Row="1" Margin="0,10,0,0"
                    Classes="gameTabControl">
            <TabItem Classes="gameTabItem"
                     Header="{extensions:Localize 'Settings_Data_SectionTitle'}">
                <fragments:DataSectionFragment/>
            </TabItem>
            <TabItem Classes="gameTabItem"
                     Header="{extensions:Localize 'Settings_Hub_SectionTitle'}">
                <fragments:HubConfigurationFragment/>
            </TabItem>
        </TabControl>
        </Grid>
    </Grid>
</UserControl>
