<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Sanet.MakaMek.Presentation.ViewModels;assembly=Sanet.MakaMek.Presentation"
             xmlns:templatedControls="clr-namespace:Sanet.MakaMek.Avalonia.Controls.TemplatedControls;assembly=Sanet.MakaMek.Avalonia.Controls"
             xmlns:extensions="clr-namespace:Sanet.MakaMek.Avalonia.Controls.Extensions;assembly=Sanet.MakaMek.Avalonia.Controls"
             xmlns:fragments="clr-namespace:Sanet.MakaMek.Avalonia.Views.Settings.Fragments"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
             x:DataType="viewModels:SettingsViewModel"
             x:Class="Sanet.MakaMek.Avalonia.Views.Settings.SettingsViewWide">

    <Grid>
        <templatedControls:HexagonBackground/>
        <Grid Margin="10" RowDefinitions="Auto,*">
            <!-- Toolbar with Back Button -->
            <templatedControls:ToolBar
                Title="{extensions:Localize 'SettingsView_Title'}"
                TitleAlignment="Center"
                LeftCommand="{Binding BackCommand}"
                LeftIcon="{StaticResource BackArrowIcon}"/>

            <!-- Scrollable two-column content, centered and limited to 800px -->
            <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="800" HorizontalAlignment="Center" Spacing="20">
                    <Grid ColumnDefinitions="*,*">
                        <fragments:DataSectionFragment Grid.Column="0" VerticalAlignment="Top"/>
                        <fragments:HubConfigurationFragment Grid.Column="1" VerticalAlignment="Top"
                                                            Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
