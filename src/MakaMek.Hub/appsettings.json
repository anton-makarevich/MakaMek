{
  "Hub": {
    "ApiKey": "",
    "MaxConcurrentRooms": 100,
    "JoinRateLimitPerMinute": 10,
    "RelayRateLimitPerMinute": 120,
    "MaxRelayPayloadBytes": 262144,
    "RoomTtlSeconds": 7200,
    "DissolutionGracePeriodSeconds": 30,
    "PeerDisconnectNotificationDelaySeconds": 5,
    "SignalR": {
      "KeepAliveIntervalSeconds": 15,
      "ClientTimeoutIntervalSeconds": 30
    },
    "TrustedProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Server.Kestrel": "None",
      "Microsoft.AspNetCore.HttpLogging": "None"
    }
  }
}
