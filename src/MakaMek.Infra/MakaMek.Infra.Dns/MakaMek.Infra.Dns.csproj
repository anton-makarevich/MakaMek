<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Sanet.MakaMek.Infra.Dns</RootNamespace>
        <!-- Pulumi projects are never packed; suppress packaging-only props inherited from Directory.Build.props -->
        <IsPackable>false</IsPackable>
        <AssemblyName>Sanet.MakaMek.Infra.Dns</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Pulumi" Version="3.*" />
        <PackageReference Include="Pulumi.Cloudflare" Version="6.*" />
    </ItemGroup>

</Project>
