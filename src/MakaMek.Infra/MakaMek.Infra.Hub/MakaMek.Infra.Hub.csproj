<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Sanet.MakaMek.Infra.Hub</RootNamespace>
        <!-- Pulumi projects are never packed; suppress packaging-only props inherited from Directory.Build.props -->
        <IsPackable>false</IsPackable>
        <AssemblyName>Sanet.MakaMek.Infra.Hub</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Pulumi" Version="3.114.1" />
        <PackageReference Include="Pulumi.Oci" Version="5.2.0" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Templates\**" />
    </ItemGroup>

</Project>
