<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>MW5Extractor.Cli</AssemblyName>
        <RootNamespace>MakaMek.Tools.MW5Extractor.Cli</RootNamespace>
        <Description>CLI wrapper over the MW5Extractor library: mount, ls, find, inspect, extract, discovery-report</Description>
        <!-- Transitive advisories from CUE4Parse-Conversion; see the comment in the library project. -->
        <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.14" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MW5Extractor\MW5Extractor.csproj" />
    </ItemGroup>

</Project>
