<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The linked gate source already declares a Main; keep the test SDK from generating another. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <AssemblyName>Sanet.MakaMek.AnalyzerGate.Tests</AssemblyName>
    <RootNamespace>Sanet.MakaMek.AnalyzerGate.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The gate is a file-based app, so its single source file is compiled into the test
         assembly to make the pure suppression-scanning logic testable. -->
    <Compile Include="..\..\tools\analyzer-gate\AnalyzerGate.cs" Link="AnalyzerGate.cs" />
  </ItemGroup>

</Project>
